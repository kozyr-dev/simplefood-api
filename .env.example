# Copy to .env and adjust. .env is gitignored.

# --- docker-compose (local infra) ---
POSTGRES_USER=simplefood
POSTGRES_PASSWORD=simplefood
POSTGRES_DB=simplefood
POSTGRES_PORT=5433
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- API (validated in src/config/env.validation.ts) ---
NODE_ENV=development
PORT=1339
# Optional. fatal | error | warn | info | debug | trace | silent.
# Leave unset to use the per-NODE_ENV default (test: silent, development: debug,
# production: info); setting it here would also apply to the e2e tests.
# LOG_LEVEL=debug
DB_HOST=localhost
DB_PORT=5433
DB_USER=simplefood
DB_PASSWORD=simplefood
DB_NAME=simplefood
CORS_ORIGINS=http://localhost:3000
SMTP_HOST=localhost
SMTP_PORT=1025
